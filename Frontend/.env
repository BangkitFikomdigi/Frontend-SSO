# URL backend SSO (Laravel). API_BASE dipilih otomatis oleh src/config/api.js
# berdasarkan host yang dipakai buka frontend ini:
#  - dibuka via http://localhost:5173      -> pakai VITE_API_BASE_URL_LOCAL
#  - dibuka via http://192.168.4.22:5173   -> pakai VITE_API_BASE_URL
VITE_API_BASE_URL=http://192.168.4.22:8000
VITE_API_BASE_URL_LOCAL=http://localhost:8000
VITE_API_URL=http://127.0.0.1:8000/api
